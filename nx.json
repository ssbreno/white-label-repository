{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "nxCloudAccessToken": "",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "e2e"]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json", "{workspaceRoot}/.eslintignore"],
      "cache": true
    },
    "dev": {
      "cache": false
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json"
    ],
    "sharedGlobals": ["{workspaceRoot}/babel.config.json"]
  },
  "generators": {
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "startTargetName": "start",
        "serveStaticTargetName": "serve-static"
      }
    }
  ],
  "projects": {
    "frontend": {
      "root": "apps/frontend",
      "sourceRoot": "apps/frontend/src",
      "projectType": "application",
      "targets": {
        "dev": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/frontend && npm run dev",
            "cwd": "{workspaceRoot}"
          }
        },
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/frontend && npm run build",
            "cwd": "{workspaceRoot}"
          }
        },
        "lint": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/frontend && npm run lint",
            "cwd": "{workspaceRoot}"
          }
        },
        "test": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/frontend && npm run test",
            "cwd": "{workspaceRoot}"
          }
        }
      }
    },
    "backend": {
      "root": "apps/backend",
      "projectType": "application",
      "targets": {
        "dev": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/backend && go run ./cmd/server",
            "cwd": "{workspaceRoot}"
          }
        },
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/backend && go build -o dist/server ./cmd/server",
            "cwd": "{workspaceRoot}"
          }
        },
        "test": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd apps/backend && go test ./...",
            "cwd": "{workspaceRoot}"
          }
        }
      }
    },
    "shared-types": {
      "root": "libs/shared/types",
      "sourceRoot": "libs/shared/types/src",
      "projectType": "library",
      "targets": {
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd libs/shared/types && npm run build",
            "cwd": "{workspaceRoot}"
          }
        }
      }
    },
    "shared-utils": {
      "root": "libs/shared/utils",
      "sourceRoot": "libs/shared/utils/src",
      "projectType": "library",
      "targets": {
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd libs/shared/utils && npm run build",
            "cwd": "{workspaceRoot}"
          }
        }
      }
    },
    "shared-config": {
      "root": "libs/shared/config",
      "sourceRoot": "libs/shared/config/src",
      "projectType": "library",
      "targets": {
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "cd libs/shared/config && npm run build",
            "cwd": "{workspaceRoot}"
          }
        }
      }
    }
  }
}
